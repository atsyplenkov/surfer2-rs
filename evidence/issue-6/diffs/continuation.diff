+/// Three constraints collapse together only when every edge actually meets.
+///
+/// The earliest single-axis time can be a closest approach of tens of metres,
+/// or a slow edge's meet a few microseconds before a fast vertex arrives.
+/// When the early time still leaves an open side, wait for the later real
+/// meet. When only one side meets, collapse that edge and leave the third
+/// vertex moving.
+fn bounded_constrained_3(
+    kt: &KineticTriangulation,
+    t: &KineticTriangle,
+    time_now: f64,
+) -> Result<CollapseSpec, PropagationError> {
+    let eps = three_const_meet_eps(kt, t);
+    let mut real = Vec::new();
+    for s in 0..3 {
+        let Some(tc) = constraint_meet_time(kt, t, s, time_now) else {
+            continue;
+        };
+        if constraint_endpoint_distance(kt, t, s, tc) <= eps {
+            real.push((tc, s));
+        }
+    }
+    if real.len() == 3 {
+        let t_early = real.iter().map(|r| r.0).fold(f64::INFINITY, f64::min);
+        let t_late = real.iter().map(|r| r.0).fold(f64::NEG_INFINITY, f64::max);
+        let early_ok = (0..3).all(|s| constraint_endpoint_distance(kt, t, s, t_early) <= eps);
+        if early_ok {
+            return Ok(CollapseSpec::new(
+                t.component,
+                CollapseType::TriangleCollapse,
+                t_early,
+            ));
+        }
+        let late_ok = (0..3).all(|s| constraint_endpoint_distance(kt, t, s, t_late) <= eps);
+        if late_ok {
+            return Ok(CollapseSpec::new(
+                t.component,
+                CollapseType::TriangleCollapse,
+                t_late,
+            ));
+        }
+    }
+    if let Some(&(tc, s)) = real.iter().min_by(|a, b| a.0.total_cmp(&b.0)) {
+        return Ok(CollapseSpec::with_edge(
+            t.component,
+            CollapseType::ConstraintCollapse,
+            tc,
+            s as i8,
+        ));
+    }
+    let mut tmin = f64::INFINITY;
+    for s in 0..3 {
+        if let Some(tc) = constraint_collapse_time(kt, t, s, time_now) {
+            tmin = tmin.min(tc);
+        }
+    }
+    Ok(CollapseSpec::new(
+        t.component,
+        CollapseType::TriangleCollapse,
+        if tmin.is_finite() { tmin } else { time_now },
+    ))
+}
+
+fn three_const_meet_eps(kt: &KineticTriangulation, t: &KineticTriangle) -> f64 {
+    let mut scale: f64 = 1.0;
+    for vid in t.vertices.into_iter().flatten() {
+        if let Some(v) = kt.vertices.get(vid) {
+            // Birth point, not the back-projected origin. A fast vertex's
+            // origin can sit 1e8 away and would inflate the tolerance.
+            scale = scale
+                .max(v.pos_start.x.abs())
+                .max(v.pos_start.y.abs());
+        }
+    }
+    // About 6 mm on a projected basin, and far below a unit-polygon edge.
+    (1e-9 * scale).clamp(1e-12, 1e-2)
+}
+
+fn constraint_endpoint_distance(
+    kt: &KineticTriangulation,
+    t: &KineticTriangle,
+    side: usize,
+    time: f64,
+) -> f64 {
+    let Some(eid) = t.wavefronts[side] else {
+        return f64::INFINITY;
+    };
+    let Some(e) = kt.edges.get(eid) else {
+        return f64::INFINITY;
+    };
+    let (Some(v0), Some(v1)) = (
+        kt.vertices.get(e.endpoints[0]),
+        kt.vertices.get(e.endpoints[1]),
+    ) else {
+        return f64::INFINITY;
+    };
+    v0.position_at(time).distance_to(v1.position_at(time))
+}
+
+/// Future time at which the two endpoints are closest in the plane.
+///
+/// `compute_edge_collapse_f64` divides by one axis and treats an edge as
+/// vertical only when that axis is exactly zero. A projected edge whose
+/// relative velocity is almost parallel to the other axis then reports a
+/// meet before the points coincide. The least-squares time matches the
+/// single-axis time when the motion lies on the edge.
+fn constraint_meet_time(
+    kt: &KineticTriangulation,
+    t: &KineticTriangle,
+    side: usize,
+    now: f64,
+) -> Option<f64> {
+    let eid = t.wavefronts[side]?;
+    let e = kt.edges.get(eid)?;
+    let v0 = kt.vertices.get(e.endpoints[0])?;
+    let v1 = kt.vertices.get(e.endpoints[1])?;
+    let dx = v1.pos_zero.x - v0.pos_zero.x;
+    let dy = v1.pos_zero.y - v0.pos_zero.y;
+    let vx = v0.velocity.x - v1.velocity.x;
+    let vy = v0.velocity.y - v1.velocity.y;
+    let den = vx * vx + vy * vy;
+    if den > 0.0 {
+        let tc = (dx * vx + dy * vy) / den;
+        if tc.is_finite() && tc > now {
+            return Some(tc);
+        }
+    }
+    constraint_collapse_time(kt, t, side, now)
+}
