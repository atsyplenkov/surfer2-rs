+        arcs += 1;
+    }
+    let components = (0..parents.len())
+        .map(|i| root(&mut parents, i))
+        .collect::<HashSet<_>>()
+        .len();
+    let cycle_rank = arcs as isize - parents.len() as isize + components as isize;
